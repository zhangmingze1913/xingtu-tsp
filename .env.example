# HTTP server
TSP_BIND=127.0.0.1:8090

# Database: SQLite path, postgres://, or mysql:// URL
TSP_DATABASE=data/tsp.db
# TSP_DATABASE=postgres://tsp:password@127.0.0.1:5432/tsp?sslmode=disable
# TSP_DATABASE=mysql://tsp:password@127.0.0.1:3306/tsp

# Static console directory
TSP_WEB_DIR=web

# RS256 key pair. Production must use persistent files shared by all API nodes.
# TSP_JWT_PRIVATE_KEY_FILE=/etc/tsp/jwt-private.pem
# TSP_JWT_PUBLIC_KEY_FILE=/etc/tsp/jwt-public.pem
# Development: if unset, a process-local key is generated (tokens die on restart).
TSP_JWT_KEY_ID=tsp-rs256-1
TSP_JWT_ACCESS_TTL_MINUTES=15
TSP_JWT_REFRESH_TTL_HOURS=168
# Keep old public keys for the token rotation window: kid=path,kid=path
# TSP_JWT_PREVIOUS_KEYS=old-1=/etc/tsp/jwt-old-1.pem

# JT/T 808 TCP gateway. Production should set TLS cert/key and disable plaintext.
TSP_JT808_ADDR=127.0.0.1:18080
# TSP_JT808_TLS_CERT=/etc/tsp/jt808-cert.pem
# TSP_JT808_TLS_KEY=/etc/tsp/jt808-key.pem
TSP_JT808_ALLOW_PLAINTEXT=true
# Optional mTLS: require terminal client cert signed by this CA.
# TSP_JT808_CLIENT_CA=/etc/tsp/secret/jt808-client-ca.pem
# Optional peer CIDR allowlist.
# TSP_JT808_ALLOWED_CIDRS=10.0.0.0/8,192.168.0.0/16

# Cluster profile (requires PostgreSQL + Redis)
TSP_CLUSTER_MODE=false
TSP_REDIS_URL=redis://127.0.0.1:6379/0
# Production: rediss://:password@redis:6379/0 and leave plaintext disabled.
TSP_REDIS_ALLOW_PLAINTEXT=false
TSP_NODE_ID=local-node
TSP_NODE_ROLE=api
# production | development (production enforces secret/demo/command checks)
TSP_ENV=development
TSP_COMMAND_MODE=simulated
TSP_POSTGIS_ENABLED=true
# Comma-separated browser origins; empty = same-origin only
TSP_CORS_ORIGINS=
# Required only when TSP_ENV=production and users table is empty
# TSP_ADMIN_PASSWORD=change-me-to-a-long-password
# OpenRaft control plane (leader election / cluster metadata).
# TSP_RAFT_ENABLED=true
TSP_RAFT_NODE_ID=1
TSP_RAFT_ADDR=127.0.0.1:7001
# TSP_RAFT_PEERS=1@127.0.0.1:7001,2@127.0.0.1:7002,3@127.0.0.1:7003
TSP_RAFT_BOOTSTRAP=true
# Optional Apache Iggy HTTP event log (replaces Redis Pub/Sub for events)
# TSP_IGGY_URL=http://127.0.0.1:3000
TSP_IGGY_STREAM=xingtu-tsp
TSP_IGGY_TOPIC=events
TSP_IGGY_USERNAME=iggy
TSP_IGGY_PASSWORD=iggy
# Optional tsink time-series store (Prometheus-compatible HTTP)
# TSP_TSINK_URL=http://127.0.0.1:9201
# TSP_TSINK_TOKEN=
# Optional TDengine REST SQL (taosAdapter)
# TSP_TDENGINE_URL=http://127.0.0.1:6041
TSP_TDENGINE_USER=root
TSP_TDENGINE_PASSWORD=taosdata
TSP_TDENGINE_DATABASE=tsp
# Optional Walrus durable event archive (length-prefixed TCP)
# TSP_WALRUS_ADDR=127.0.0.1:8080
TSP_WALRUS_TOPIC=tsp-events

# Embedded fleet simulator (set false for real terminals)
TSP_DEMO_MODE=true

# Log level
RUST_LOG=xingtu_tsp=info,tower_http=warn

# RustFS S3-compatible object storage (docker-compose / k8s)
# Console: http://127.0.0.1:9001  S3: http://127.0.0.1:9000
# Change both credentials outside local development.
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
# JT/T 1078 media UDP ingress (needed for recording)
TSP_MEDIA_UDP_ADDR=127.0.0.1:19000

# RustFS media archive (application side)
TSP_RUSTFS_ARCHIVE=true
TSP_RUSTFS_ENDPOINT=http://127.0.0.1:9000
TSP_RUSTFS_BUCKET=tsp-media
TSP_RUSTFS_REGION=us-east-1
TSP_RUSTFS_ACCESS_KEY=rustfsadmin
TSP_RUSTFS_SECRET_KEY=rustfsadmin
TSP_RUSTFS_PREFIX=media
TSP_RUSTFS_SEGMENT_SECS=30
# Flush earlier than the time limit when the raw segment grows past this size.
TSP_RUSTFS_SEGMENT_BYTES=8388608
# Hard cap: drop a video segment that never reaches an I-frame.
TSP_RUSTFS_SEGMENT_MAX_BYTES=67108864
TSP_RUSTFS_UPLOAD_RETRIES=3
TSP_RUSTFS_UPLOAD_TIMEOUT_SECS=30
TSP_RUSTFS_UPLOAD_CONCURRENCY=4
TSP_RUSTFS_RETENTION_DAYS=0
TSP_RUSTFS_CLEANUP_INTERVAL_SECS=3600
TSP_ARCHIVE_PLAYBACK_CACHE_ITEMS=8
TSP_ARCHIVE_PLAYBACK_CACHE_BYTES=67108864
TSP_ARCHIVE_SPOOL_DIR=data/archive-spool
TSP_ARCHIVE_SPOOL_REPLAY_SECS=60

